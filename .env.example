# URL pública do site (canonical, sitemap, Open Graph).
SITE_URL=http://localhost:3002

# Base pública dos instaladores (pasta que contém latest.json). Vazio = botões de download ficam como "solicitar acesso".
UPDATES_BASE_URL=

# E-mail de contato para pedir acesso / suporte.
CONTACT_EMAIL=

# Código de verificação do Google Search Console (opcional).
GOOGLE_SITE_VERIFICATION=

# Formulário de contato comercial (envia leads para certificate-plus-api). Sem os dois, o formulário responde "tente novamente".
# URL base da API, sem barra final.
LEADS_API_URL=
# Service key com escopo public.leads.write. Segredo: só no servidor, nunca NEXT_PUBLIC_.
# Gere na API: go run ./cmd/api service-key -name site -scopes public.leads.write
LEADS_API_KEY=
