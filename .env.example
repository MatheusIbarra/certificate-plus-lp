# URL pública do site (canonical, sitemap, Open Graph).
SITE_URL=http://localhost:3002

# Base pública dos instaladores (pasta que contém latest.json). Vazio = botões de download ficam como "solicitar acesso".
UPDATES_BASE_URL=

# E-mail de contato para pedir acesso / suporte.
CONTACT_EMAIL=

# Código de verificação do Google Search Console (opcional).
GOOGLE_SITE_VERIFICATION=
